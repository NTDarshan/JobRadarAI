# --- LLM: OpenAI is tried first; if its quota/credits are exhausted, ---
# --- the app automatically falls back to Groq for the rest of the run. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Web search across trusted job boards (free tier, no credit card): ---
# --- sign up at https://app.tavily.com ---
TAVILY_API_KEY=

# --- Email delivery (same pattern as TechRadar AI) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Tuning ---
MAX_JOBS_PER_SOURCE=40
MAX_AI_JOBS=40
MIN_MATCH_SCORE=90
TOP_MATCHES_COUNT=5

# --- "Already seen" tracking (SQLite) so the same posting isn't re-analyzed or ---
# --- re-emailed on a later day. On GitHub Actions this file is committed back to ---
# --- the repo after each run — see .github/workflows/daily_job_search.yml. ---
SEEN_STORE_PATH=data/seen_jobs.db
SEEN_JOBS_RETENTION_DAYS=60
